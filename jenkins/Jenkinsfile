pipeline {
  agent any

  environment {
    // REGISTRY = "localhost:5000"       // nếu có local registry
    IMAGE_PY = "${REGISTRY}/python-service"
    IMAGE_PHP = "${REGISTRY}/php-service"
    IMAGE_FE = "${REGISTRY}/frontend"
  }

  stages {
    stage('Checkout') {
      steps {
        git(
          url: 'https://github.com/Lunaricku/webshop.git',
          branch: 'test',
        )
      }
    }

    stage('Build & Test Backend Python') {
      steps {
        dir('backend/python_service') {
          sh 'docker build -t $IMAGE_PY:${BUILD_NUMBER} .'
        }
      }
    }

    stage('Build & Test Backend PHP') {
      steps {
        dir('backend/php_service') {
          sh 'docker build -t $IMAGE_PHP:${BUILD_NUMBER} .'
        }
      }
    }

    stage('Build Frontend') {
      steps {
        dir('frontend') {
          sh 'docker build -t $IMAGE_FE:${BUILD_NUMBER} .'
        }
      }
    }

    stage('Push Images') {
      steps {
        // Nếu dùng local registry, push ở đây; nếu không, có thể skip
        sh 'docker push $IMAGE_PY:${BUILD_NUMBER}'
        sh 'docker push $IMAGE_PHP:${BUILD_NUMBER}'
        sh 'docker push $IMAGE_FE:${BUILD_NUMBER}'
      }
    }

    stage('Deploy to On-Prem') {
      steps {
        // Giả sử chạy Jenkins trên chính máy deploy
        sh """
          cd backend
          docker-compose down
          # cập nhật image tags trong docker-compose.yml nếu cần
          docker-compose up -d --build
        """
      }
    }
  }

  post {
    success {
      echo 'Deployment succeeded!'
    }
    failure {
      echo 'Deployment failed!'
    }
  }
}
